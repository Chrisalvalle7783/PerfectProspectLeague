{
  "expo": {
    "name": "Perfect Prospect League",
    "slug": "perfect-prospect-league",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perfectprospect.league"
    },
    "android": {
      "package": "com.perfectprospect.league",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#02070d"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
